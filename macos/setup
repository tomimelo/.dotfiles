#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export DEV_ENV="$PWD"

if ! command -v brew >/dev/null 2>&1; then
    echo "Install Homebrew first: https://brew.sh" >&2
    exit 1
fi

brew install neovim tmux fzf tree-sitter-cli
brew tap nikitabobko/tap
brew trust nikitabobko/tap
brew install --cask ghostty nikitabobko/tap/aerospace karabiner-elements slack stats

brew install colima docker docker-compose docker-buildx

# Docker CLI only scans ~/.docker/cli-plugins on macOS; brew installs plugins
# under /opt/homebrew/lib/docker/cli-plugins which is never discovered.
mkdir -p "$HOME/.docker/cli-plugins"
ln -sf "$(brew --prefix)/lib/docker/cli-plugins/docker-compose" "$HOME/.docker/cli-plugins/docker-compose"
ln -sf "$(brew --prefix)/lib/docker/cli-plugins/docker-buildx" "$HOME/.docker/cli-plugins/docker-buildx"

# Migrate off the brew service: it starts colima once and gives up on failure
# (no retry, no stale-state recovery after unclean shutdowns).
brew services stop colima >/dev/null 2>&1 || true
rm -f "$HOME/Library/LaunchAgents/homebrew.mxcl.colima.plist"

if [ -x "$(brew --prefix)/opt/fzf/install" ]; then
    "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc --no-bash --no-fish
fi

if [ ! -d "$HOME/.oh-my-zsh" ]; then
    git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
fi

git submodule update --init
git -C env/.config/nvim checkout main || true

mkdir -p "$HOME/.local/bin" "$HOME/.config"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Menu bar (clock, tray) on every display. Needs a logout to apply.
defaults write com.apple.spaces spans-displays -bool false
defaults write com.apple.dock expose-group-apps -bool true
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0.2
killall Dock 2>/dev/null || true

./macos/dev-env
./macos/configure-stats

# Auto-start the Docker engine at login via our LaunchAgent.
launchctl bootout gui/"$(id -u)/com.tomimelo.colima" >/dev/null 2>&1 || true
launchctl bootstrap gui/"$(id -u)" "$HOME/Library/LaunchAgents/com.tomimelo.colima.plist"
