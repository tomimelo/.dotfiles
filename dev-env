#!/usr/bin/env bash
set -euo pipefail

dry_run="0"

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if [[ "${1:-}" == "--dry" ]]; then
    dry_run="1"
fi

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

link() {
    local source=$1
    local dest=$2

    if [ ! -e "$source" ] && [ ! -L "$source" ]; then
        log "skip: $source missing"
        return 0
    fi

    mkdir -p "$(dirname "$dest")"

    if [ -L "$dest" ] && [ "$(readlink -f "$dest")" = "$(readlink -f "$source")" ]; then
        log "ok: $dest already linked"
        return 0
    fi

    if [ -e "$dest" ] || [ -L "$dest" ]; then
        log "removing: $dest"
        if [[ $dry_run == "0" ]]; then
            rm -rf "$dest"
        fi
    fi

    log "link: $dest -> $source"
    if [[ $dry_run == "0" ]]; then
        ln -s "$source" "$dest"
    fi
}

link_hypr() {
    local source=$1
    local dest=$2
    local file
    local name

    # hyprland regenerates a stub config if ~/.config/hypr is removed or
    # replaced with a symlink, so link the files inside a real dir instead
    mkdir -p "$dest"

    for file in "$source"/*; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        name=$(basename "$file")

        if [ -L "$dest/$name" ] && [ "$(readlink -f "$dest/$name")" = "$(readlink -f "$file")" ]; then
            log "ok: $dest/$name already linked"
            continue
        fi

        log "link: $dest/$name -> $file"
        if [[ $dry_run == "0" ]]; then
            ln -sf "$file" "$dest/$name"
        fi
    done
}

link_each() {
    local source_dir=$1
    local dest_dir=$2
    local entry
    local name

    [ -d "$source_dir" ] || return 0

    for entry in "$source_dir"/*; do
        name=$(basename "$entry")
        if [[ "$name" == "hypr" ]]; then
            link_hypr "$entry" "$dest_dir/$name"
        else
            link "$entry" "$dest_dir/$name"
        fi
    done
}

shopt -s dotglob nullglob

log "env: $DEV_ENV"

link_each "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
link_each "$DEV_ENV/env/.local/bin" "$HOME/.local/bin"
link_each "$DEV_ENV/env/.local/scripts" "$HOME/.local/scripts"

link "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
link "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
link "$DEV_ENV/env/.xprofile" "$HOME/.xprofile"
link "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload
fi
